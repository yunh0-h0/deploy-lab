{
  "name": "deploy-lab-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "start": "node index.js",
    "db:migrate": "node --env-file-if-exists=.env migrate.js",
    "db:check": "node --env-file-if-exists=.env check-db.js",
    "db:migrate:cloud": "node --env-file=.env.cloud.local migrate.js",
    "start:cloud": "node migrate.js && node index.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.12 <27"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
